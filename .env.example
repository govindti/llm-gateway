# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
JSON_BODY_LIMIT=256kb
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Infrastructure (matches docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://gateway:gateway@localhost:5432/llm_gateway"
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Hard deadline for a single provider call before falling back (milliseconds)
PROVIDER_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Rate limiting (sliding window, per API key)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
# true  -> allow the request when Redis is unavailable (availability first)
# false -> fail closed with 503 when Redis is unavailable (safety first)
RATE_LIMIT_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# Response cache
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Comma separated STATIC admin keys. They shortcut the database and are useful
# for bootstrapping; every other credential is issued through POST /auth/keys
# or `bun run auth:key --name <name> --role admin`.
# There is no permissive mode: a request without a valid key is always rejected.
API_KEYS=
# How long a validated key stays cached before Postgres is consulted again
AUTH_CACHE_TTL_SECONDS=60
